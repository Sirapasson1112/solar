  flag:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 21V4"/><path d="M5 5h11l-2 3.5L16 12H5"/></svg>',
};

const GROUPS = [
  {key:'transformer', name:'หม้อแปลง', accent:'--amber', dim:'--amber-dim',
   tasks:['ตรวจสอบสภาพหม้อแปลงไฟฟ้าประจำเดือน','ตรวจวัดค่าความเป็นฉนวนน้ำมันหม้อแปลง','บันทึกค่าโหลดและอุณหภูมิหม้อแปลง',
          'เปลี่ยนถ่ายน้ำมันหม้อแปลงที่ครบกำหนด','ตรวจสอบระบบระบายความร้อน','ทำความสะอาดลูกถ้วยและขั้วต่อ',
          'ตรวจสอบสายดินหม้อแปลง','จัดทำรายงานสภาพหม้อแปลงประจำเดือน']},
  {key:'public', name:'ไฟฟ้าสาธารณะ', accent:'--blue', dim:'--blue-dim',
   tasks:['ตรวจสอบไฟฟ้าแสงสว่างสาธารณะทั้งเส้นทาง','เปลี่ยนหลอดไฟถนนที่ชำรุด','ซ่อมแซมโคมไฟที่เสียหาย',
