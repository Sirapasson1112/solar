function tickClock(){
  const now = new Date();
  document.getElementById('clockText').textContent = now.toLocaleTimeString('th-TH');
}
setInterval(tickClock, 1000); tickClock();

/* ---------------- INIT ---------------- */
function renderAll(){
  renderSidebar();
  renderTop();
  renderDepts();
}
renderAll();
renderWorkflow();
</script>
