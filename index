  {key:'outage', name:'ไฟฟ้าขัดข้อง', accent:'--red', dim:'--red-dim',
   tasks:['ตอบสนองเหตุไฟฟ้าดับเร่งด่วน','ตรวจสอบสาเหตุไฟฟ้าขัดข้อง','ซ่อมแซมจุดที่เกิดไฟฟ้าลัดวงจร',
          'เปลี่ยนอุปกรณ์ป้องกันที่ชำรุด (ฟิวส์/เบรกเกอร์)','บันทึกและวิเคราะห์สาเหตุไฟฟ้าขัดข้อง','ประสานทีมกู้ภัยกรณีฉุกเฉิน',
          'ตรวจสอบระบบหลังซ่อมแซมเสร็จสิ้น','จัดทำรายงานสรุปเหตุขัดข้องประจำเดือน']},
  {key:'maintenance', name:'บำรุงรักษาระบบจำหน่าย', accent:'--green', dim:'--green-dim',
   tasks:['ตัดแต่งต้นไม้ใกล้แนวสายไฟฟ้า','ตรวจสอบระยะห่างสายไฟฟ้ากับสิ่งปลูกสร้าง','บำรุงรักษาเสาไฟฟ้าและอุปกรณ์ยึดโยง',
          'ทดสอบระบบป้องกันฟ้าผ่า','ตรวจสอบและขันแน่นจุดต่อสายไฟฟ้า','ตรวจสอบสภาพลูกถ้วยฉนวนตลอดแนว',
          'ล้างทำความสะอาดอุปกรณ์บนเสาไฟฟ้า','จัดทำแผนบำรุงรักษาเชิงป้องกันประจำปี']},
];

const WORKFLOW = [
  {icon:'inbox', title:'รับแจ้งงาน', desc:'บันทึกคำร้อง/แจ้งเหตุเข้าระบบ CMMS'},
  {icon:'team', title:'มอบหมายทีม', desc:'จ่ายงานให้กลุ่มงานและพนักงานที่ว่าง'},
  {icon:'wrench', title:'ดำเนินงาน', desc:'ทีมช่างลงพื้นที่ปฏิบัติงานจริง'},
  {icon:'check', title:'ตรวจสอบคุณภาพ', desc:'หัวหน้างานตรวจรับและยืนยันผล'},
  {icon:'flag', title:'ปิดงาน', desc:'บันทึกผลและปิดใบสั่งงานในระบบ'},
];

const TODAY = new Date(2026,7,27); // 27 Aug 2026
const MONTH = 7; const YEAR = 2026; const DAYS_IN_MONTH = 31;

/* seeded pseudo-random */
function seeded(seed){ const x = Math.sin(seed)*10000; return x - Math.floor(x); }

function buildDeptData(districtId, group, groupIdx){
  const base = districtId*10 + groupIdx;
  const staff = 4 + Math.floor(seeded(base*1.1)*6);              // 4-9
  const completion = 38 + Math.floor(seeded(base*2.3)*58);        // 38-95
  const tasks = group.tasks.map((name, i)=>{
    const s = base*7 + i*3.1;
    const day = 1 + Math.floor(seeded(s)*DAYS_IN_MONTH);
    let status;
    if(day < TODAY.getDate()-2) status = seeded(s*1.7) > 0.15 ? 'done' : 'pending';
    else if(day <= TODAY.getDate()+1) status = seeded(s*1.3) > 0.5 ? 'doing' : 'pending';
    else status = 'pending';
    return {name, day, status};
  }).sort((a,b)=>a.day-b.day);
  const urgent = group.key==='outage' && tasks.filter(t=>t.status==='pending' && t.day<=TODAY.getDate()+2).length;
  return {staff, completion, tasks, urgent};
}

const DATA = {};
DISTRICTS.forEach(d=>{
  DATA[d.id] = GROUPS.map((g,i)=>buildDeptData(d.id,g,i));
});

/* ---------------- RENDER: SIDEBAR ---------------- */
const districtListEl = document.getElementById('districtList');
let activeDistrict = 1;

function renderSidebar(){
  districtListEl.innerHTML = DISTRICTS.map(d=>{
    const gd = DATA[d.id];
    const totalStaff = gd.reduce((a,x)=>a+x.staff,0);
    const totalTasks = gd.reduce((a,x)=>a+x.tasks.length,0);
    const segs = gd.map(x=>`var(${GROUPS[gd.indexOf(x)]?.accent||'--amber'})`);
    return `
    <li>
      <button class="district-btn ${d.id===activeDistrict?'active':''}" data-id="${d.id}">
        <div class="d-name"><span>${d.name}</span><span class="d-led"></span></div>
        <div class="d-region">${d.region}</div>
        <div class="d-region" style="margin-top:4px;">${totalStaff} คน · ${totalTasks} งาน/เดือน</div>
        <div class="d-stack">
          ${gd.map((x,i)=>`<span style="width:${100/gd.length}%; background:var(${GROUPS[i].accent})"></span>`).join('')}
        </div>
      </button>
    </li>`;
  }).join('');
  districtListEl.querySelectorAll('.district-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{ activeDistrict = Number(btn.dataset.id); renderAll(); });
  });
}

/* ---------------- RENDER: TOPBAR + STATS ---------------- */
function renderTop(){
  const d = DISTRICTS.find(x=>x.id===activeDistrict);
  document.getElementById('districtTitle').innerHTML = `${d.name}<span class="region-tag">${d.region}</span>`;

  const gd = DATA[activeDistrict];
  const totalStaff = gd.reduce((a,x)=>a+x.staff,0);
  const totalTasks = gd.reduce((a,x)=>a+x.tasks.length,0);
  const doneTasks = gd.reduce((a,x)=>a+x.tasks.filter(t=>t.status==='done').length,0);
  const urgent = gd.reduce((a,x)=>a+(x.urgent||0),0);

  document.getElementById('statRow').innerHTML = `
    <div class="stat-card"><div class="label">พนักงานทั้งหมด</div><div class="value">${totalStaff}<small> คน</small></div></div>
    <div class="stat-card"><div class="label">งานเดือนนี้</div><div class="value">${totalTasks}<small> งาน</small></div></div>
    <div class="stat-card"><div class="label">งานเสร็จแล้ว</div><div class="value">${doneTasks}<small> / ${totalTasks}</small></div></div>
    <div class="stat-card"><div class="label">งานเร่งด่วน (ขัดข้อง)</div><div class="value" style="color:${urgent>0?'var(--red)':'var(--text-hi)'}">${urgent}<small> รายการ</small></div></div>
  `;
}

/* ---------------- RENDER: DEPT CARDS ---------------- */
const DOW = ['อา','จ','อ','พ','พฤ','ศ','ส'];

function ring(pct, colorVar){
  const r = 22, c = 2*Math.PI*r;
  const off = c - (pct/100)*c;
  return `<svg width="56" height="56" viewBox="0 0 56 56">
    <circle cx="28" cy="28" r="${r}" fill="none" stroke="var(--grid-line)" stroke-width="5"/>
    <circle cx="28" cy="28" r="${r}" fill="none" stroke="var(${colorVar})" stroke-width="5"
      stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${off}"/>
  </svg>`;
}

function calendarHTML(group, dept, accentVar){
  let cells = `<div class="cal-grid">` + DOW.map(d=>`<div class="cal-dow">${d}</div>`).join('');
  const firstDow = new Date(YEAR, MONTH, 1).getDay();
  for(let i=0;i<firstDow;i++) cells += `<div class="cal-cell blank"></div>`;
  for(let day=1; day<=DAYS_IN_MONTH; day++){
    const t = dept.tasks.find(x=>x.day===day);
    const isToday = day===TODAY.getDate();
    let cls = 'cal-cell' + (t?' has-task':'') + (isToday?' today':'');
    let dotColor = t ? (t.status==='done'?'var(--green)':t.status==='doing'?'var(--amber)':'var(--text-low)') : 'transparent';
    cells += `<div class="${cls}" style="--accent:var(${accentVar})">
      ${day}
      ${t?`<span class="tname">${t.name}</span><span class="dot" style="background:${dotColor}"></span>`:''}
    </div>`;
  }
  cells += `</div>`;
  return cells;
}

function renderDepts(){
  const gd = DATA[activeDistrict];
  const grid = document.getElementById('deptGrid');
  grid.innerHTML = GROUPS.map((g,i)=>{
    const dept = gd[i];
    const statusColor = dept.completion>=70?'var(--green)':dept.completion>=40?'var(--amber)':'var(--red)';
    const doneCount = dept.tasks.filter(t=>t.status==='done').length;
    const doingCount = dept.tasks.filter(t=>t.status==='doing').length;
    const shown = dept.tasks.slice(0,5);
    return `
    <div class="dept-card" style="--accent:var(${g.accent}); --accent-dim:var(${g.dim})">
      <div class="dept-head">
        <div class="dept-id">
          <div class="dept-icon">${ICONS[g.key]}</div>
          <div>
            <div class="dept-name">${g.name}</div>
            <div class="dept-tag">GROUP-0${i+1} · เขต ${activeDistrict}</div>
          </div>
        </div>
        <div class="switch on" style="--status-color:${statusColor}" title="สถานะกลุ่มงาน"></div>
      </div>

      <div class="dept-metrics">
        <div class="ring-wrap">${ring(dept.completion, g.accent)}<div class="pct">${dept.completion}%</div></div>
        <div class="metric-list">
          พนักงานประจำกลุ่ม &nbsp;<b>${dept.staff} คน</b><br>
          เสร็จแล้ว <b>${doneCount}</b> · กำลังทำ <b>${doingCount}</b> · รอดำเนินการ <b>${dept.tasks.length-doneCount-doingCount}</b>
        </div>
      </div>

      <ul class="task-list">
        ${shown.map(t=>`
          <li>
            <span class="task-dot ${t.status}"></span>
            <span class="task-name">${t.name}</span>
            <span class="task-date">${String(t.day).padStart(2,'0')} ส.ค.</span>
          </li>`).join('')}
      </ul>

      <div class="dept-foot">
        ${dept.urgent ? `<span class="urgent-flag">${dept.urgent} งานเร่งด่วนรอทีม</span>` : `<span></span>`}
        <button class="expand-btn" data-key="${g.key}">
          ดูปฏิทินทั้งเดือน
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="cal-panel" id="cal-${g.key}">
      <div class="cal-head">
        <h3>ปฏิทินงาน — ${g.name} (สิงหาคม 2569)</h3>
        <span>เขต ${activeDistrict} · ${dept.tasks.length} งานในเดือนนี้</span>
      </div>
      ${calendarHTML(g, dept, g.accent)}
    </div>
    `;
  }).join('');

  grid.querySelectorAll('.expand-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.dataset.key;
      const panel = document.getElementById('cal-'+key);
      const isOpen = panel.classList.contains('show');
      grid.querySelectorAll('.cal-panel').forEach(p=>p.classList.remove('show'));
      grid.querySelectorAll('.expand-btn').forEach(b=>b.classList.remove('open'));
      if(!isOpen){ panel.classList.add('show'); btn.classList.add('open'); }
    });
  });
}

/* ---------------- RENDER: WORKFLOW ---------------- */
function renderWorkflow(){
  const el = document.getElementById('wfSteps');
  el.innerHTML = `<div class="wf-wire"></div>` + WORKFLOW.map((s,i)=>`
    <div class="wf-step ${i<2?'done':i===2?'active':''}">
      <div class="wf-node">${WF_ICONS[s.icon]}</div>
      <div class="wf-title">${s.title}</div>
      <div class="wf-desc">${s.desc}</div>
    </div>
  `).join('');
}

