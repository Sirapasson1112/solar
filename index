    </div>
  </aside>

  <!-- MAIN -->
  <main class="main">
    <div class="topbar">
      <div>
        <h1 id="districtTitle">เขต 1<span class="region-tag" id="districtTag">ภาคเหนือ</span></h1>
      </div>
      <div class="topbar-right">
        <div class="month">สิงหาคม 2569</div>
        <div><span class="clock-dot"></span>ระบบทำงานปกติ — เชื่อมต่อสด</div>
      </div>
    </div>

    <div class="stat-row" id="statRow"></div>

    <div class="section-head">
      <h2>กลุ่มงานประจำเขต — 4 กลุ่มงาน</h2>
      <span class="hint">คลิก “ดูปฏิทินทั้งเดือน” เพื่อดูตารางงานรายวันของกลุ่มงานนั้น</span>
    </div>
    <div class="dept-grid" id="deptGrid"></div>

    <div class="section-head" style="margin-top:30px;">
      <h2>เวิร์กโฟลว์การทำงานของแต่ละกลุ่มงาน</h2>
      <span class="hint">ทุกกลุ่มงานใช้ขั้นตอนมาตรฐานเดียวกัน ตั้งแต่รับแจ้งจนถึงปิดงาน</span>
    </div>
    <div class="workflow">
      <div class="wf-steps" id="wfSteps"></div>
    </div>

  </main>
</div>

<script>
/* ---------------- DATA ---------------- */
const DISTRICTS = [
  {id:1, name:'เขต 1', region:'ภาคเหนือ'},
  {id:2, name:'เขต 2', region:'ภาคกลาง'},
  {id:3, name:'เขต 3', region:'ภาคตะวันออกเฉียงเหนือ'},
