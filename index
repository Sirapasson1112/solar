];

const ICONS = {
  transformer:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="9" cy="8" r="4.2"/><circle cx="15" cy="16" r="4.2"/><path d="M9 12v4M15 8v4"/></svg>',
